# Database Secret Credentials Example
# Copy this file to application-secret.properties in the same directory and set your actual database credentials.
spring.datasource.url=jdbc:postgresql://your-neon-hostname/neondb?sslmode=require
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password

# Clerk Backend Secret Key
# Retrieve from Clerk Dashboard -> API Keys -> Secret key (starts with sk_test_)
clerk.secret-key=sk_test_your_clerk_secret_key_here
